import sys
sys.path.append("..")

import pandas as pd
import matplotlib.pyplot as plt
from src.features import build_features

df = pd.read_csv("../data/market_data.csv", index_col=0, parse_dates=True)
feats = build_features(df)
feats.describe()

fig, axes = plt.subplots(3, 1, figsize=(12, 9), sharex=True)
df["spx"].plot(ax=axes[0], title="S&P 500")
feats["vol_21"].plot(ax=axes[1], title="21-day realized volatility")
feats["vix"].plot(ax=axes[2], title="VIX")
plt.tight_layout()
plt.savefig("../results/figures/eda_overview.png", dpi=150)
plt.show()
